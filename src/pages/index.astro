---
import Base from '../layouts/Base.astro'
import TagChip from '../components/TagChip.astro'
import { daysSinceFirst, fmtDate, publishedPosts } from '../utils/posts'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const posts = await publishedPosts()
---
<Base title="개발 기록">
  <div class="home">
    <aside class="intro">
      <h1>쇼핑몰을 만들며 남기는 기록</h1>
      <p>한국 상품을 인도네시아 고객 대신 사서 보내 주는 구매대행 쇼핑몰의 개발 일지입니다.</p>
      <div class="stats">
        <div><b>{posts.length}</b>글</div>
        <div><b>{daysSinceFirst(posts)}</b>일째</div>
      </div>
    </aside>
    <ol class="timeline">
      {posts.map((p) => (
        <li class="entry">
          <time datetime={fmtDate(p.data.date)}>{fmtDate(p.data.date)}</time>
          <h2><a href={`${base}/posts/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.summary}</p>
          <div class="chips">{p.data.tags.map((t) => <TagChip tag={t} />)}</div>
        </li>
      ))}
    </ol>
  </div>
</Base>
