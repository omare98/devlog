---
import PostView from '../../components/PostView.astro'
import { entriesFor } from '../../utils/posts'

export async function getStaticPaths() {
  const entries = await entriesFor('ko')
  return entries.map((entry) => ({ params: { id: entry.slug }, props: { entry } }))
}

const { entry } = Astro.props
---
<PostView entry={entry} />
