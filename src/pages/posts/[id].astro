---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import TagChip from '../../components/TagChip.astro'
import { fmtDate, publishedPosts } from '../../utils/posts'

export async function getStaticPaths() {
  const posts = await publishedPosts()
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const { post } = Astro.props
const { Content } = await render(post)
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="article">
    <a class="back" href={`${base}/`}>‹ 글 목록</a>
    <header>
      <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.summary}</p>
      <div class="chips">{post.data.tags.map((t) => <TagChip tag={t} />)}</div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
