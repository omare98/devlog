---
interface Props {
  title: string
  description?: string
}
const { title, description = '쇼핑몰을 만들며 남기는 개발 기록' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === '개발 기록' ? title : `${title} · 개발 기록`}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="개발 기록" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header>
      <a class="brand" href={`${base}/`}>개발 기록</a>
      <nav><a href={`${base}/`}>글</a> <a href={`${base}/rss.xml`}>RSS</a></nav>
    </header>
    <main><slot /></main>
    <footer>© 개발 기록</footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #fbfaf7; --fg: #23201a; --muted: #6b6558; --line: #e6e1d4; --accent: #b3261e; --code: #f1eee6;
    --font: "Pretendard Variable", Pretendard, "Noto Sans KR", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #17150f; --fg: #ece8dc; --muted: #a39d8c; --line: #2f2b20; --accent: #ff8a80; --code: #231f16; }
  }
  * { box-sizing: border-box }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.75 var(--font);
    padding-inline: max(16px, env(safe-area-inset-left, 0px)) }
  header, main, footer { max-width: 720px; margin-inline: auto }
  header { display: flex; justify-content: space-between; align-items: baseline; padding-block: 28px 12px; border-bottom: 1px solid var(--line) }
  .brand { font-weight: 800; font-size: 1.25rem; color: var(--fg); text-decoration: none }
  nav a { color: var(--muted); margin-left: 14px; text-decoration: none }
  a { color: var(--accent) }
  main { padding-block: 24px 48px }
  footer { color: var(--muted); font-size: .85rem; padding-block: 24px; border-top: 1px solid var(--line) }
  h1, h2, h3 { line-height: 1.3; text-wrap: balance }
  pre { background: var(--code); padding: 14px; border-radius: 8px; overflow-x: auto; font-size: .875rem }
  code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace }
  img { max-width: 100%; height: auto }
  .meta { color: var(--muted); font-size: .875rem }
  .tag { display: inline-block; background: var(--code); border-radius: 99px; padding: 0 10px; font-size: .8rem; margin-right: 6px }
  ul.posts { list-style: none; padding: 0; display: grid; gap: 22px }
  ul.posts h2 { margin: 0; font-size: 1.15rem }
  ul.posts a { color: var(--fg); text-decoration: none }
  ul.posts a:hover { color: var(--accent) }
</style>
